# URL do web app do Apps Script (Implantar > App da Web). Sem ela, o app roda do snapshot.
APPS_SCRIPT_URL=
# Mesmo valor gravado no script com setToken('...'). Só é usado nos POSTs (atividades, avançar dia).
API_TOKEN=
# Senha dos controles da demo (Simulação: avançar o dia, zerar, ligar o job). Mudam a planilha pra todo mundo.
DEMO_ADMIN_PASSWORD=
