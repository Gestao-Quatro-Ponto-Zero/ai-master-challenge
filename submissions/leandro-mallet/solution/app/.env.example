# Copie para .env.local (fora do git) e preencha. Sem as duas primeiras, o app abre no modo arquivo.

# Banco (Supabase). A chave service_role é usada SÓ no servidor; nunca vai para o navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 1 = sem banco, aceita mudanças em memória (somem ao reiniciar). Serve para testar o app sem credenciais.
G4_ESCRITA_EM_MEMORIA=0

# 1 = força o modo somente leitura.
G4_SOMENTE_LEITURA=0
