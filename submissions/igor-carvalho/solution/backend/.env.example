# Copie para .env (cp .env.example .env) e ajuste. O .env não vai para o git.

# Segredo do JWT (mínimo 32 caracteres). TROQUE em produção.
G4_JWT_SECRET=troque-este-segredo-com-no-minimo-32-caracteres
G4_JWT_TTL_MINUTES=480

# Caminhos (API e treinador precisam apontar para os mesmos ARTIFACT_DIR e DB_PATH)
G4_DATA_DIR=data
G4_ARTIFACT_DIR=artifacts
G4_DB_PATH=var/app.db

# API
G4_SHOW_PROBABILITY=true
G4_RATE_LIMIT_PER_MINUTE=120
G4_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
