# Copie para .env (ou .env.local) para mudar o comportamento. Ambos ficam fora do git.

# URL do backend. Usada pelo proxy do `npm run dev` e pelo `npm run test:integration`.
G4_API_URL=http://localhost:8000
# Vendedor usado no login (user_key). Opcional.
# G4_API_USER=vicki-laflamme

# mock = API simulada no navegador (padrão) | http = API real (FastAPI)
# VITE_API_MODE=mock

# Só no modo http. Padrão: /api/v1 (o Vite encaminha /api para VITE_API_PROXY_TARGET).
# VITE_API_BASE_URL=/api/v1
# (VITE_API_PROXY_TARGET ainda funciona, mas G4_API_URL tem prioridade)
# VITE_API_PROXY_TARGET=http://localhost:8000

# Só no modo mock
# VITE_MOCK_LATENCY_MS=200
# Mostra "Chance estimada de ganhar" no detalhe (no modo http vem de GET /meta)
# VITE_SHOW_PROBABILITY=false
