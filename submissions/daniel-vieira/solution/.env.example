# .env.example --- Variaveis de ambiente do banco e da aplicacao.
#
# Copie para '.env' e defina os valores reais. Estas variaveis alimentam tanto o
# servico de banco quanto a aplicacao (ver 'compose.yaml'); a aplicacao recebe
# PGHOST, PGPORT e o endereco de vinculo pelo proprio compose, de modo que este
# arquivo cobre apenas os parametros de banco e o segredo. O arquivo '.env'
# permanece fora do controle de versao (ver '.gitignore'); apenas este exemplo e
# versionado. Segredos (em particular PGPASSWORD) nunca sao embutidos no compose
# nem em codigo, conforme o ADR D4M3 e o principio de seguranca desde a concepcao.

# Imagem oficial do PostgreSQL, com a versao fixada (ADR D4M3, N4P8) e o registro
# qualificado, para compatibilidade com o Podman sob politica de nomes curtos.
POSTGRES_IMAGE=docker.io/library/postgres:17

# Parametros de conexao consumidos pelo codigo Common Lisp (Postmodern) e pelos
# scripts de provisionamento. PGHOST/PGPORT referem-se ao ponto de acesso do
# cliente; dentro do compose, os servicos referem-se ao banco pelo nome 'db'.
PGHOST=localhost
PGPORT=5433
PGDATABASE=leadscorer
PGUSER=leadscorer
PGPASSWORD=troque-este-valor
