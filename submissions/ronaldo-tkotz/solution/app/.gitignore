# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local databases (app.sqlite, RavenStack copies) — never commit
/data/*.db
/data/*.sqlite
/data/*.sqlite-*
/data/*.zip
# Uploaded datasets live on the runtime volume — never commit local ones.
/data/datasets/

# Interceptor / QA screenshot artifacts
/interceptor-screenshot-*.png

# Agent worktrees (session-local, never committed)
.claude/
