# RavenStack churn app — environment variables

# Model (DeepSeek, OpenAI-compatible API)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# RavenStack database (read-only), built by solution/sql/build_db.py
WAREHOUSE_PATH=

# App database (chats, saved items)
APP_DB_PATH=./data/app.sqlite

# Login
AUTH_USERNAME=avaliador
AUTH_PASSWORD=
AUTH_SECRET=
