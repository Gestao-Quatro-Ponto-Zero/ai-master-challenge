# Copie para .env e preencha. Nunca commite o .env.

# Supabase (projeto G4-Analysys, ref hzerhfuwziundqqezgcm)
SUPABASE_URL=https://hzerhfuwziundqqezgcm.supabase.co
# Chave secreta (sb_secret_...) ou service_role — só no pipeline local/cron, nunca no front.
SUPABASE_SECRET_KEY=
# Connection string do pooler (Dashboard > Connect > Session pooler), com a senha do banco.
DATABASE_URL=

# Fonte Kaggle (MCP remoto). Token opcional: o acesso anônimo funciona para datasets públicos.
KAGGLE_MCP_URL=https://www.kaggle.com/mcp
KAGGLE_DATASET=rivalytics/saas-subscription-and-churn-analytics-dataset
KAGGLE_MCP_TOKEN=
