# Copie para backend/.env e preencha. Credenciais EXCLUSIVAS do Lead Scorer —
# conta e chave criadas só para este projeto.

# ── IA (OpenAI) ── sem chave, a ferramenta usa os textos automáticos (template)
LEAD_SCORER_OPENAI_API_KEY=
LEAD_SCORER_LLM_MODEL=gpt-4o
LEAD_SCORER_IA_MAX_PERGUNTAS_DIA=200

# ── E-mails ── 'arquivo' só gera os HTMLs em backend/saida_emails/; 'enviar' manda via SMTP
LEAD_SCORER_EMAIL_MODO=arquivo
# Para testes: manda TODOS os e-mails para este endereço, nunca para os destinatários reais
LEAD_SCORER_EMAIL_REDIRECIONAR=
LEAD_SCORER_SMTP_HOST=
LEAD_SCORER_SMTP_PORT=587
LEAD_SCORER_SMTP_USER=
LEAD_SCORER_SMTP_PASSWORD=
LEAD_SCORER_SMTP_FROM=

# ── Link usado nos e-mails ──
LEAD_SCORER_URL_APP=http://localhost:3001
