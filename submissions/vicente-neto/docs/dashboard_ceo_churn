<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>RavenStack: diagnóstico de churn para o CEO</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#f5f6f8;--card:#fff;--ink:#14202b;--mute:#5b6875;--line:#dde2e8;--blue:#1f5fbf;--yes:#17704f;--yes-bg:#e4f2ec;--no:#a8392b;--no-bg:#f8e7e4;--chk:#8a5a00;--chk-bg:#f9efd9;--track:#e8ecf1;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0f161d;--card:#18222c;--ink:#e8edf2;--mute:#9aa8b6;--line:#2a3743;--blue:#6ea3f0;--yes:#5fcf9f;--yes-bg:#14332a;--no:#f0897a;--no-bg:#3a1f1b;--chk:#e8b95a;--chk-bg:#352a12;--track:#26323d}}
:root[data-theme="dark"]{--bg:#0f161d;--card:#18222c;--ink:#e8edf2;--mute:#9aa8b6;--line:#2a3743;--blue:#6ea3f0;--yes:#5fcf9f;--yes-bg:#14332a;--no:#f0897a;--no-bg:#3a1f1b;--chk:#e8b95a;--chk-bg:#352a12;--track:#26323d}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.55 "IBM Plex Sans",system-ui,sans-serif}
main{max-width:1040px;margin:0 auto;padding:28px 18px 56px}
h1,h2{font-family:"Source Serif 4",Georgia,serif;line-height:1.15;margin:0}
h1{font-size:clamp(28px,5vw,44px);max-width:20ch}
h2{font-size:24px;margin-bottom:6px}
p{margin:0}.sub{color:var(--mute);max-width:68ch}
section{margin-top:44px}
.hero .sub{margin-top:14px;font-size:17px;color:var(--ink)}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px;margin-top:24px}
.kpi{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:14px 16px}
.kpi b{display:block;font:700 28px/1.1 "Source Serif 4",Georgia,serif}
.kpi span{font-size:14px;color:var(--mute)}
.cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:14px;margin-top:16px}
.col{border-radius:10px;padding:16px 18px;border:1px solid var(--line);background:var(--card);border-top:4px solid var(--c)}
.col h3{margin:0 0 8px;font-size:17px;color:var(--c)}
.col ul{margin:0;padding-left:18px}.col li{margin:0 0 8px;font-size:15px}
.code{color:var(--mute);font-size:12px;white-space:nowrap}
.yes{--c:var(--yes)}.no{--c:var(--no)}.chk{--c:var(--chk)}
