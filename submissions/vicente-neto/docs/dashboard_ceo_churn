.cc em{font-style:normal;color:var(--mute);margin-top:4px}.cc u{text-decoration:none;font-weight:600;margin-bottom:2px}
.hb{display:grid;grid-template-columns:132px 1fr 62px;align-items:center;gap:8px;margin:7px 0;font-size:14px}
