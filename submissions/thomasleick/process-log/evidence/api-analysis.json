  "findings": [
    {
      "id": "label_conflict",
      "title": "Churn labels do not reconcile",
      "statement": "Event history and account status produce materially different customer counts.",
      "evidence": [
        "600 event rows across 352 accounts",
        "110 account churn flags",
        "277 event accounts have churn_flag=False"
      ],
      "interpretation": "Do not use either label as validated logo churn until the lifecycle contract is clarified.",
      "confidence": "HIGH"
    },
    {
      "id": "raw_event_growth",
      "title": "Recorded event volume rises sharply",
      "statement": "The CSV has 73 event rows in 2023 and 527 in 2024.",
      "evidence": [
        "Counts are event rows, not eligible-account churn rates",
        "Unique accounts by year: 64 and 327"
      ],
      "interpretation": "This supports growth in recorded events only; denominator, censoring and reactivation handling are unresolved.",
      "confidence": "HIGH"
    },
    {
      "id": "usage_not_matching",
      "title": "Raw usage totals do not rise at the same pace",
      "statement": "Monthly usage rows and usage_count remain in a similar range across the observed window.",
      "evidence": [
        "250525 total usage count across 25000 rows",
        "19142 usage rows precede subscription start"
      ],
      "interpretation": "Invalidly timed records prevent a reliable per-active-account engagement trend.",
      "confidence": "HIGH"
    },
    {
      "id": "satisfaction_missing",
      "title": "Ticket satisfaction is flat in an all-time split",
      "statement": "Mean recorded scores are nearly the same for accounts with and without any churn event.",
      "evidence": [
        "Any-event accounts: n=815, mean=3.9804",
        "No-event accounts: n=360, mean=3.9833",
        "Missing ticket scores: 825/2000"
      ],
      "interpretation": "This is not a pre-churn comparison and does not establish a trend or causal protection.",
      "confidence": "MEDIUM"
    }
  ],
  "methodology": [
    "Event rows, unique event accounts, account churn flags, and ended subscription rows are reported separately.",
    "Usage and ticket tables are aggregated at their entity level; one-to-many joins are validated.",
    "Monthly event counts are not called churn rates without eligible-account denominators and clean lifecycle history.",
    "Refund sums are not treated as recurring revenue loss.",
    "No predictive model or causal intervention estimate is emitted."
  ]
}
