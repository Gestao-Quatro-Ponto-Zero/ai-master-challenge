    {
      "id": "36853ee9-2c0c-467c-aa2b-8d7bd8c10913",
      "name": "Preparar decisão",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        224,
        368
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "hitl_id",
              "name": "hitl_id",
              "value": "={{ Number($json.body?.hitl_id ?? $json.hitl_id ?? 0) }}",
              "type": "number"
            },
            {
              "id": "decision",
              "name": "decision",
              "value": "={{ String($json.body?.decision ?? $json.decision ?? \"\").toLowerCase().trim() }}",
              "type": "string"
            },
            {
              "id": "final_text",
              "name": "final_text",
              "value": "={{ String($json.body?.final_text ?? \"\").trim() }}",
              "type": "string"
            },
            {
              "id": "final_category",
              "name": "final_category",
              "value": "={{ String($json.body?.final_category ?? \"\").trim() }}",
              "type": "string"
            },
            {
              "id": "reviewer",
              "name": "reviewer",
              "value": "={{ String($json.body?.reviewer ?? \"revisor\").trim() }}",
              "type": "string"
            },
            {
              "id": "note",
              "name": "note",
              "value": "={{ String($json.body?.note ?? \"\").trim() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "9a5be3e0-cc8a-44b9-be74-c5a3b49706d7",
      "name": "Entrada válida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        448,
        368
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.hitl_id }}",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "rightValue": 0
            },
            {
              "leftValue": "={{ [\"approve\", \"edit\", \"reject\"].includes($json.decision) }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "leftValue": "={{ $json.decision !== \"edit\" || $json.final_text.length > 0 }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "leftValue": "={{ $json.final_category === \"\" || [\"Access\", \"Administrative rights\", \"HR Support\", \"Hardware\", \"Internal Project\", \"Miscellaneous\", \"Purchase\", \"Storage\"].includes($json.final_category) }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "23ed978f-ab59-4032-aee8-dd3d6d17d1ce",
