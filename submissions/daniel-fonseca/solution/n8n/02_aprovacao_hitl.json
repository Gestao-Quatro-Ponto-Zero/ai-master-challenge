    {
      "id": "a92ecb91-d68c-48ca-bac0-9308a6656c1d",
      "name": "Qual decisão?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        1344,
        128
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "Aprovar ou editar",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ [\"approve\", \"edit\"].includes($(\"Preparar decisão\").item.json.decision) }}",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "Rejeitar",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $(\"Preparar decisão\").item.json.decision }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "reject"
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "Decisão desconhecida"
        }
      }
    },
