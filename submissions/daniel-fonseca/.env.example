# Copie para .env e preencha. Nunca commitar o .env.
# Não use comentários na mesma linha do valor (alguns parsers incluem o comentário no valor).

# Supabase (conta dedicada ao case)
SUPABASE_URL=
# https://<ref>.supabase.co
SUPABASE_ANON_KEY=
# só em scripts/servidor, nunca no front
SUPABASE_SERVICE_ROLE_KEY=
# Connect → "Session pooler" (IPv4), usado pelos scripts de carga:
# postgresql://postgres.<ref>:<senha-sem-colchetes>@aws-1-<regiao>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# OpenAI (embeddings + geração): no n8n fica como credencial; aqui só para scripts de carga
OPENAI_API_KEY=

# n8n (VPS). O app da Vercel chama os webhooks do n8n, por isso precisa da URL base.
N8N_BASE_URL=
# Segredo compartilhado: o app envia no header X-Webhook-Secret e o nó Webhook valida (Header Auth).
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
N8N_WEBHOOK_SECRET=

# Opcional: só para o Codex (o Claude Code registra o n8n-g4 em escopo local)
N8N_MCP_TOKEN=

# Slack / WhatsApp: credenciais ficam no n8n (nós do workflow), não aqui — ver docs/setup.md

# App Vercel (PRD v1.1): segredos do servidor, também cadastrados na Vercel
CRON_SECRET=
IP_HASH_SALT=
# Interruptor do texto livre (só muda por instrução do Daniel) e limites de uso (padrões em solution/app/lib/env.ts)
FREE_TEXT_ENABLED=true
